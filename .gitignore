# data are never committed (downloaded by Step 1)
data/raw/
data/processed/
data/*
!data/README.md
*.parquet
*.csv.gz
*.rds
*.RDS
# large intermediate results
*.npz
results/**/preds_*
results/brazil/metrics_detail_weekly_300.csv
# quick / smoke-test outputs
results/**/*_quick*
results/**/*_noclimate*
# python / notebooks / tools
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.env
.DS_Store
.vscode/
.idea/
# official runs: per-fold checkpoints (npz, per-fold CSV/JSON) and large per-row files
results/official/**/folds/
results/official/**/metrics_detail_*_300*.csv

# re-runs from notebook 06
results/official_rerun/

# timing extension: local run folders (checkpoints, per-row metrics)
results/extensions/timing/runs/
# timing extension S2C run: prediction arrays stay local (metrics and checks are committed)
results/extensions/timing/runs_s2c/**/*.npz
# INLA extension (exploratory): per-fold checkpoints, R work files, large per-row files
results/extensions/inla/**/folds/
results/extensions/inla/**/work/
results/extensions/inla/**/metrics_detail_*_300*.csv
results/extensions/inla/**/shape_diag_*_300*.csv
results/extensions/inla/**/R_fits.log
results/extensions/timing/runs_lc/**/*.npz
results/extensions/inla_trends/**/*.npz
results/extensions/inla_trends/**/folds/
results/extensions/inla_trends/**/work/
results/extensions/inla_trends/**/R_fits.log
# Mexico extension: INLA checkpoints and work files, smoke tests
results/extensions/mexico/**/work/
results/extensions/mexico/designC_power_300/folds/
results/extensions/mexico/**/R_fits.log
results/extensions/mexico/smoke/
# Final 2024 test: per-fold checkpoints (copies of metrics_detail) and INLA work files
results/final2024/**/folds/
results/final2024/**/work/
results/final2024_mx/**/folds/
results/final2024_mx/**/work/
